
.PS
pi=3.14159265359
                        # parametre z PIC (resp. GNU PIC)
scale = 2.54            # cm - jednotka pre obrazok
maxpswid = 30           # rozmery obrazku
maxpsht = 30            # 30 x 30cm, default je 8.5x11 inch
cct_init                # inicializacia lokalnych premennych

arrowwid  = 0.127       # parametre sipok - sirka
arrowht = 0.254         # dlzka


include(lib_base.ckt)                  
include(lib_time.ckt)
include(lib_color.ckt)

command "\sf"
Origin: Here 
Grid(13,5);              # vykreslenie pomocnej mriezky, origin je (0,0)

d=1.5
move to (2.5,4);
"\small{CK\_CNT}" at Here rjust;
level(1,L)

for i=0 to 5 do{
  clock(0.5, HL)
  level(1,L)
}


move to (2.5,3);
"\small{Counter}" at Here rjust;
data(d-0.5, "6" ,L)
data(d,"7")
data(d,"8")
data(d,"9")
data(d,"0")
data(d,"1")
data(d-0.5,"2", R)

move to (2.5,2);
"\small{PWM 1}" at Here rjust;
level(2.5,H);
pulse(3,0, HL)
pulse(4.5,0, LH)
#pulse(
#level(5,L);

move to (2.5,1);
"\small{UPDATE Flag}" at Here rjust;
level(5.5,L);
pulse(0.5, 0.0, LH)
level(3.5,H);

color_red;
line from (5, 0) to (5, 5) dashed .08;
line from (8, 0) to (8, 5) dashed .08;   

.PE
