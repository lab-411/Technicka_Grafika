#=======================================================================
# Kniznica yymmdd-time-diagram.ckt
#=======================================================================
# Kreslenie casovych diagramov
# 
#
# Obmedzenia a chyby
# ----------------------------------------------------------------------
# - nesmu sa použivat nazvy makier v textoch pre LaTex (napr. switch),
#   v pripade konfliktu mien treba použit \\ v texte (sw\\itch)
#
# - podtrzitko v obycajnom (nie math) texte je treba pisat ako \_
#
# - makro setrgb pouziva premenne r_  g_  b_
#   po jeho pouziti v skripte sa tieto inicializuju,
#   pri pouziti vyrazu napr.  r_{ab} je tento treba pisat ako r _{ab}
#
# - resetrgb() nefunguje ...
#
#-----------------------------------------------------------------------
# Historia / verzia
#
# 210717 - vytvorenie kniznice odclenenim z user.ckt
# 251110 - upravy a premenovanie signalov
# 260912 - doplnenie hran a popisu signalov
# 260913 - doplnenie pwm, event
#
#                        
#=======================================================================
# Definicia konstant
#-----------------------------------------------------------------------

pulse_edge = .05      #
pulse_level = 0.7
pulse_slope = 0.075
pulse_width = 0.5

#-----------------------------------------------------------------------
# data(d, text, L|R|X)
#-----------------------------------------------------------------------

define(`data',`[
    dx = pulse_edge;
    dy = pulse_level;
    B: box ht dy wid $1 invis;            # neviditelny  box

    ifinstr($3, L,
    {  
       line from (B.w.x , B.n.y)to (B.e.x-dx, B.n.y) to (B.e);
       line from (B.w.x , B.s.y)to (B.e.x-dx, B.s.y) to (B.e);
    },
    { 
       ifinstr($3, R,
       {
            line from B.w to (B.w.x + dx, B.n.y)to (B.e.x, B.n.y);
            line from B.w to (B.w.x + dx, B.s.y)to (B.e.x, B.s.y);
       },
       {
           ifinstr($3, X,
           {
                line from B.w to (B.w.x + dx, B.n.y) to (B.w.x + dx + dx, B.n.y);  
                line from (B.w.x + dx, B.n.y) to  (B.e.x - dx, B.n.y) dashed dx /2;
                line from  (B.e.x - dx- dx, B.n.y) to  (B.e.x - dx, B.n.y) to (B.e);

                line from B.w to (B.w.x + dx, B.s.y) to (B.w.x + dx + dx, B.s.y);
                line from (B.w.x + dx, B.s.y) to (B.e.x - dx, B.s.y) dashed dx /2;
                line from  (B.e.x - dx - dx, B.s.y) to  (B.e.x - dx, B.s.y) to (B.e);
           },
            
           {   
                line from B.w to (B.w.x + dx, B.n.y)to (B.e.x-dx, B.n.y) to (B.e);
                line from B.w to (B.w.x + dx, B.s.y)to (B.e.x-dx, B.s.y) to (B.e);
            })
       })
    })

    ifinstr($2," ",
        {},
        {$2 at B.c;}
     )
]')

#-----------------------------------------------------------------------
# clock(d, HL|LH)  
# clock pulse 1:1
#-----------------------------------------------------------------------

define(`clock',`[
    dx = pulse_edge;
    dy = pulse_level;
    dt = pulse_slope;
    B: box ht dy wid $1 invis;            # neviditelny  box
    ifinstr($2, LH,
    {
        # LH
        SU: B.sw;
        EU: B.s+(-dt/2,0);
        SD: B.n+(dt/2,0);
        ED: B.ne+(-dt,0);
        line from SU to EU to SD to ED to B.se;
        
    }, 
    {
        # HL
        SU: B.sw;
        EU: B.nw+(dt,0);
        SD: B.n+(-dt/2,0);
        ED: B.s+(dt/2,0);
        line from SU to EU to SD to ED to B.se;
    })
    
    CU: (SU+EU)/2;
    CD: (SD+ED)/2;
]')

#-----------------------------------------------------------------------
# pulse(d, delay, HL|LH)  
# delay - oneskorenie v jednotkach d
#-----------------------------------------------------------------------
define(`pulse',`[
    dy = pulse_level;
    dt = $1 * $2
    B: box ht dy wid $1 invis;            # neviditelny  box
    ifinstr($3, LH,
      {  
        line from (B.w.x, B.s.y) to  (B.w.x + dt - pulse_slope/2, B.s.y) to (B.w.x + dt + pulse_slope/2, B.n.y) to (B.e.x, B.n.y)
        S: (B.w.x + dt - pulse_slope/2, B.s.y)     # pulse begin
        E: (B.w.x + dt + pulse_slope/2, B.n.y)     # pulse end
      },
      {
        ifinstr($3, HL,
            {
                line from (B.w.x, B.n.y) to  (B.w.x + dt - pulse_slope/2, B.n.y) to (B.w.x + dt + pulse_slope/2, B.s.y) to (B.e.x, B.s.y)
                S: (B.w.x + dt - pulse_slope/2, B.n.y)     # pulse begin
                E: (B.w.x + dt + pulse_slope/2, B.s.y)     # pulse end
            },
            { }
        );
      }
    );
    
    C: (S+E)/2; 
]')


#-----------------------------------------------------------------------
# level(d, H|L|X, D)  
# H|L|X - logicke urovne, treti stav
# D     - delay, ciarkovana
#-----------------------------------------------------------------------

define(`level',`[
    dx = pulse_edge;
    dy = pulse_level;

    B: box ht dy wid $1 invis;            # neviditelny  box

    value = 10;                           # finta - dlzka ciarky pri dashed
    ifinstr($3, D, value = 0.1, )

    ifinstr($2, H, 
        {
            ifinstr($3, X,
                {line from B.nw to (B.ne.x -dx, B.ne.y) to B.e},
                {line from B.nw to B.ne dashed value; }
            )
        
        }, 
    )

    ifinstr($2, L, 
        {
            ifinstr($3, X,
                {line from B.sw to (B.se.x-dx, B.se.y) to B.e},
                {line from B.sw to B.se dashed value;}
                ) 
        
        
        }, 
    )
    
    ifinstr($2, X, {
         
        ifinstr($3, L, {line from B.w  to (B.w.x + dx, B.se.y) to B.se;  }, 
        
            {ifinstr($3, H, {line from B.w to (B.w.x + dx, B.ne.y) to B.ne;  }, 
                      {line from B.w to B.e dashed value; }
        )
        })
        
        
    })
]')

#-----------------------------------------------------------------------
# pwm(d, HL|LH, width)  
# width - sirka jednotkach dlzky d
#-----------------------------------------------------------------------

define(`pwm',`[
    dx = pulse_edge;
    dy = pulse_level;
    dt = pulse_slope;
    dw = $1 * $3
    d=$1
    B: box ht dy wid $1 invis;            # neviditelny  box
    ifinstr($2, LH,
    {
        # LH
        SU: B.sw+(-dt/2,0) +( d-dw,0);
        EU: B.nw+( dt/2,0) + (d-dw, 0);
        SD: B.ne+(-dt,0);
        ED: B.se;
        line from B.sw to B.sw+(-dt/2,0) +( d-dw,0) to B.nw+( dt/2,0) + (d-dw, 0) to B.ne+(-dt,0) to B.se;
        
    }, 
    {
        # HL
        SU: B.sw;
        EU: B.nw +  (dt,0) ;
        SD: B.nw + (-dt/2,0)+(dw,0);
        ED: B.sw +  (dt/2,0)+(dw,0);
        line from SU to EU to SD to ED to B.se;
    })
    
    CU: (SU+EU)/2;
    CD: (SD+ED)/2;
]')


#-----------------------------------------------------------------------
# event(start, end, offset)  
#-----------------------------------------------------------------------
define(`event', `
    AA: (0.25 between $1 and $2) +  ($3,0);
    BB: (0.75 between $1 and $2) -  ($3,0);
    CC: (0.5  between $1 and $2);
    dot(at $1, 0.025);
    dot(at $2, 0.025);
    spline -> 1  from $1 to  AA then to BB then to $2; 
')


#-----------------------------------------------------------------------
# irq(name)
#-----------------------------------------------------------------------
define(`irq',`[
    B: box wid 3 ht 1 at (1.5, 0.5) dashed invis;
    arc cw from (0, 0.5) to (0.5,1);
    arc cw from (0.5, 1) to (1.5,1);
    arc cw from (1.5, 1) to (2.5,1);
    arc cw from (2.5, 1) to (3, 0.5) with .c at (2.75, 0.75);
    arc ccw from (2.5, 0) to (3, 0.5) with .c at (2.65, 0.35);
    arc ccw from (1.5, 0) to (2.5, 0);
    arc ccw from (0.5, 0) to (1.5, 0);
    arc ccw from (0, 0.5) to (0.5, 0) with .c at (0.35, 0.35);
    "$1" at B.c;

]')

#=======================================================================
# Koniec dokumentu
#=======================================================================

